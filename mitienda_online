  <a class="float-wa wa-link" href="#" aria-label="Abrir WhatsApp">☏ WhatsApp</a>

  <script>
    /* CAMBIA este número si algún día usas otro WhatsApp.
       Formato internacional sin +, espacios ni guiones: Ecuador = 593 + número. */
    const WHATSAPP = '593962882225';
    const mensajeGeneral = 'Hola, vi la página de Variedades Jousgaby y quisiera información sobre sus productos.';
    const waUrl = (mensaje) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
    document.querySelectorAll('.wa-link').forEach(link => link.href = waUrl(mensajeGeneral));
    document.querySelectorAll('.product-wa').forEach(link => {
      link.href = waUrl(`Hola, vi la página de Variedades_JousGaby y me interesa: ${link.dataset.product}. ¿Me das más información?`);
    });
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
